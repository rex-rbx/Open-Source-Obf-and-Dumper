        THEME.warning)
    return
end

local function stillMine()
    if not myCanvas or not myCanvas.Parent then return false end
    local owner = myCanvas:GetAttribute("Owner")
    if owner ~= nil and owner ~= 0 and tostring(owner) == tostring(player.UserId) then
        return true
    end
    local co = myCanvas:GetAttribute("CoOwners")
    if type(co) == "string" and string.find(co, "_" .. tostring(player.UserId) .. "_") then
        return true
    end
    return false
end

