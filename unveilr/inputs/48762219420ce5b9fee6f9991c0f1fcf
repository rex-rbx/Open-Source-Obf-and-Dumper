local function showAlert(title, body, color)
    local gui = makeGui()
    scrim(gui)
    local card = buildCard(gui, 380, 300)
    pad(card, 20)
    vstack(card, 14)
    header(card, title, color, 1)
    divider(card, 2)
    bodyText(card, body, 3)
    local ok = makeButton(card, "OK", "primary", 4)
    local done = false
    ok.MouseButton1Click:Connect(function() done = true end)
    while not done do task.wait() end
    gui:Destroy()
